<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    默认包源是 nuget.org。
    如果本机准备了离线包（仓库上一层的 .tools\nuget-local），build.ps1 / publish.ps1
    会自动识别并优先从离线目录还原，不需要改这个文件。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
