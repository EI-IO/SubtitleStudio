<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        x:Class="SubtitleStudio.App.Views.MainWindow"
        Title="{DynamicResource L.App.Title}"
        Width="1380" Height="800"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#151518"
        FontFamily="Microsoft YaHei">

  <DockPanel>

    <!-- 底部状态条：文件名 / 语言 / 重置布局 / 错误 / 进度 / 识别模型 -->
    <Border DockPanel.Dock="Bottom" Background="#1C1C21" Padding="12,4" BorderBrush="#2A2A31" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
        <TextBlock Text="{Binding MediaTitle}" Foreground="#7F8798"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />

        <!-- 语言切换放在文件名后面；面板被拖乱时再从旁边一键还原默认四区 -->
        <ComboBox Grid.Column="1" x:Name="LanguageBox" FontSize="11" Padding="7,1" Height="22"
                  MinWidth="96" Margin="14,0,0,0" VerticalAlignment="Center"
                  AutomationProperties.Name="LanguageBox"
                  SelectionChanged="OnLanguageChanged"
                  ToolTip.Tip="{DynamicResource L.Language.Tooltip}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Content="{DynamicResource L.Button.ResetLayout}" FontSize="11" Padding="8,1" Margin="8,0,12,0"
                VerticalAlignment="Center" Click="OnResetLayoutClick"
                ToolTip.Tip="{DynamicResource L.Tip.ResetLayout}" />

        <Panel Grid.Column="3" Margin="0,0,12,0" VerticalAlignment="Center">
          <Border Background="#3A1B1B" BorderBrush="#6B2B2B" BorderThickness="1" CornerRadius="3"
                  Padding="7,1" HorizontalAlignment="Left" Cursor="Hand"
                  IsVisible="{Binding HasError}" PointerPressed="OnErrorClick">
            <ToolTip.Tip>
              <StackPanel Spacing="4" MaxWidth="560">
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="11.5" />
                <TextBlock Text="{DynamicResource L.Tip.CopyError}" FontSize="10.5" Foreground="#8A8A93" />
              </StackPanel>
            </ToolTip.Tip>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="⚠" Foreground="#FF9A9A" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ErrorShort}" Foreground="#FFBEBE" FontSize="11.5"
                         VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Panel>

        <ProgressBar Grid.Column="4" IsVisible="{Binding IsBusy}" Value="{Binding Progress}" Maximum="1"
                     Width="170" Height="6" Margin="0,0,12,0" VerticalAlignment="Center" />
        <Button Grid.Column="5" Content="{DynamicResource L.Button.Elevate}" FontSize="11" Padding="8,1" Margin="0,0,12,0"
                VerticalAlignment="Center" Click="OnElevateClick"
                IsVisible="{Binding ErrorIsPermission}"
                ToolTip.Tip="{DynamicResource L.Tip.Elevate}" />
        <TextBlock Grid.Column="6" Text="{Binding AudioInfo}" Foreground="#6F7686" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- ClipToBounds：Dock 面板内容溢出时会盖住状态栏，必须裁掉 -->
    <dock:DockControl Layout="{Binding Layout}" ClipToBounds="True" />

  </DockPanel>
</Window>
