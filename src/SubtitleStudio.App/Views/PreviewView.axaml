<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SubtitleStudio.App.Controls"
             x:Class="SubtitleStudio.App.Views.PreviewView"
             FontFamily="Microsoft YaHei">
  <DockPanel Margin="8,4">

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
      <!-- 清晰度档位 + 导出画布尺寸提示 -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource L.Preview.Quality}" FontSize="11.5" Foreground="#9BA3B4" VerticalAlignment="Center" />
        <ComboBox MinWidth="118" FontSize="11.5" VerticalAlignment="Center"
                  ItemsSource="{Binding State.QualityOptions}"
                  SelectedItem="{Binding State.Quality}"
                  ToolTip.Tip="{DynamicResource L.Tip.Quality}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="{Binding State.ExportLayoutHint}" FontSize="11" Foreground="#7C8494"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding State.ExportText}" FontSize="11.5" Foreground="#9BA3B4" VerticalAlignment="Center" />
        <ProgressBar IsVisible="{Binding State.IsExporting}" Value="{Binding State.ExportProgress}"
                     Maximum="1" Width="120" Height="8" />

        <SplitButton Click="OnExportDefault" Background="#3D6FD8" Foreground="White" Padding="12,4"
                     AutomationProperties.Name="ExportButton"
                     ToolTip.Tip="{DynamicResource L.Tip.Export}">
          <Viewbox Width="16" Height="16" VerticalAlignment="Center">
            <!-- 常用「导出/上传」图标：方框 + 向上箭头 -->
            <Path Fill="White"
                  Data="M2,2 L7,2 L7,4 L4,4 L4,14 L16,14 L16,11 L18,11 L18,16 L2,16 Z M11,0 L16,5.6 L13.4,5.6 L13.4,11 L8.6,11 L8.6,5.6 L6,5.6 Z" />
          </Viewbox>
          <SplitButton.Flyout>
            <MenuFlyout>
              <MenuItem Header="{DynamicResource L.Export.TransparentWebm}" Tag="webm" Click="OnExportOverlay" />
              <MenuItem Header="{DynamicResource L.Export.TransparentMov}" Tag="mov" Click="OnExportOverlay" />
              <MenuItem Header="{DynamicResource L.Export.Mp4}" Tag="mp4" Click="OnExportOverlay" />
              <Separator />
              <MenuItem Header="{DynamicResource L.Export.Srt}" Tag="srt" Click="OnExportSubtitle" />
              <MenuItem Header="{DynamicResource L.Export.Ass}" Tag="ass" Click="OnExportSubtitle" />
              <MenuItem Header="{DynamicResource L.Export.Vtt}" Tag="vtt" Click="OnExportSubtitle" />
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>
      </StackPanel>
    </Grid>

    <Border Background="#101013" CornerRadius="4" ClipToBounds="True">
      <Panel>
        <controls:Checkerboard />
        <Image Source="{Binding State.PreviewImage}" Stretch="Uniform" />
        <TextBlock Text="{DynamicResource L.Preview.Empty}" Foreground="#5C6272" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{Binding !State.HasCues}" />
      </Panel>
    </Border>

  </DockPanel>
</UserControl>
