<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SubtitleStudio.App.Views.StyleView"
             FontFamily="Microsoft YaHei">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="10,0" VerticalAlignment="Center">

      <!-- 字体 / 字号 / 滑杆 -->
      <StackPanel Orientation="Horizontal" Spacing="6" Height="32">
        <TextBlock Text="{DynamicResource L.Style.Font}" Foreground="#9BA3B4" FontSize="12" VerticalAlignment="Center" Width="26"
                   TextAlignment="Right" />
        <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}"
                  Width="172" Height="28" FontSize="12" Padding="8,0"
                  VerticalAlignment="Center" VerticalContentAlignment="Center" />
        <TextBlock Text="{DynamicResource L.Style.FontSize}" Margin="8,0,0,0" Foreground="#9BA3B4" FontSize="12"
                   VerticalAlignment="Center" Width="26" TextAlignment="Right" />
        <NumericUpDown Value="{Binding FontSizeValue}" Minimum="12" Maximum="200" Increment="2"
                       FormatString="0" Width="112" Height="28" FontSize="12" Padding="6,0"
                       VerticalAlignment="Center" VerticalContentAlignment="Center"
                       ToolTip.Tip="{DynamicResource L.Tip.FontSize}" />
        <Slider Value="{Binding FontSize}" Minimum="24" Maximum="140" Width="88" Height="20"
                VerticalAlignment="Center" />
      </StackPanel>

      <Border Width="1" Background="#2A2A31" Margin="0,4" />

      <CheckBox Content="{DynamicResource L.Style.Bold}" IsChecked="{Binding Bold}" Foreground="#C7D0E0" FontSize="12"
                VerticalAlignment="Center" Height="28" />

      <Border Width="1" Background="#2A2A31" Margin="0,4" />

      <StackPanel Orientation="Horizontal" Spacing="6" Height="32">
        <TextBlock Text="{DynamicResource L.Style.TextColor}" Foreground="#9BA3B4" FontSize="12" VerticalAlignment="Center" />
        <Button x:Name="PrimaryColorButton" Width="22" Height="20" Padding="0" CornerRadius="3" BorderThickness="1" BorderBrush="#3A3A44"
                Background="{Binding PrimaryBrush}" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource L.Tip.Palette}">
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <!-- 色板在后台代码生成：点开直接点色，不用先切标签页 -->
              <ContentControl x:Name="PrimaryPalette" />
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBox Text="{Binding PrimaryHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 Width="96" Height="28" FontSize="11.5" Padding="6,0" MinHeight="0"
                 VerticalContentAlignment="Center" FontFamily="Consolas" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="6" Height="32">
        <TextBlock Text="{DynamicResource L.Style.OutlineColor}" Foreground="#9BA3B4" FontSize="12" VerticalAlignment="Center" />
        <Button x:Name="OutlineColorButton" Width="22" Height="20" Padding="0" CornerRadius="3" BorderThickness="1" BorderBrush="#3A3A44"
                Background="{Binding OutlineBrush}" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource L.Tip.Palette}">
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <ContentControl x:Name="OutlinePalette" />
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBox Text="{Binding OutlineHex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 Width="96" Height="28" FontSize="11.5" Padding="6,0" MinHeight="0"
                 VerticalContentAlignment="Center" FontFamily="Consolas" VerticalAlignment="Center" />
      </StackPanel>

      <Border Width="1" Background="#2A2A31" Margin="0,4" />

      <StackPanel Orientation="Horizontal" Spacing="6" Height="32">
        <TextBlock Text="{DynamicResource L.Style.OutlineWidth}" Foreground="#9BA3B4" FontSize="12" VerticalAlignment="Center" />
        <Slider Value="{Binding OutlineWidth}" Minimum="0" Maximum="12" Width="84" Height="20"
                VerticalAlignment="Center" />
        <TextBlock Text="{Binding OutlineWidth, StringFormat='{}{0:0.0}'}" Foreground="#C7D0E0" FontSize="12"
                   Width="26" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="6" Height="32">
        <TextBlock Text="{DynamicResource L.Style.MarginBottom}" Foreground="#9BA3B4" FontSize="12" VerticalAlignment="Center" />
        <Slider Value="{Binding MarginBottom}" Minimum="0" Maximum="300" Width="92" Height="20"
                VerticalAlignment="Center" />
        <TextBlock Text="{Binding MarginBottom, StringFormat='{}{0:0}'}" Foreground="#C7D0E0" FontSize="12"
                   Width="26" VerticalAlignment="Center" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
