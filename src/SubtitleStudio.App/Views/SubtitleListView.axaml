<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SubtitleStudio.App.Views.SubtitleListView"
             FontFamily="Microsoft YaHei">
  <DockPanel Margin="8,6">

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="2,0,0,6">
      <TextBlock Text="{Binding State.SelectedTrack.Label, FallbackValue='字幕列表'}" FontSize="11.5"
                 Foreground="#7F8AA0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="2" Content="清空" Click="OnClearClick" Padding="8,2" FontSize="11" />
    </Grid>

    <TextBlock DockPanel.Dock="Bottom" Margin="2,6,2,0" FontSize="11" Foreground="#6F7686"
               Text="双击时间轴空白处跳转，拖动字幕块改时间" TextWrapping="Wrap" />

    <ListBox ItemsSource="{Binding State.Cues}"
             SelectedItem="{Binding State.SelectedCue, Mode=TwoWay}"
             Background="Transparent"
             BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="104,*" Margin="0,1">
            <TextBlock Text="{Binding TimeLabel}" FontSize="10" Foreground="#7F8AA0"
                       VerticalAlignment="Center" FontFamily="Consolas" />
            <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}"
                     FontSize="12" Padding="6,2" MinHeight="0"
                     Background="#232329" BorderThickness="1" BorderBrush="#31313A" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</UserControl>

