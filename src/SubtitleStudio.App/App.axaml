<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SubtitleStudio.App"
             x:Class="SubtitleStudio.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <!-- 调色板是自绘的，没用到 ColorPicker 控件，它的样式与包都不再引入 -->
    <StyleInclude Source="avares://Dock.Avalonia.Themes.Fluent/DockFluentTheme.axaml" />

    <!-- Dock 面板标题上的「▾ 菜单」和「📌 固定」这个工具里用不上，全局隐藏 -->
    <Style Selector="Button#PART_MenuButton">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button#PART_PinButton">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Focusable" Value="False" />
    </Style>
  </Application.Styles>

</Application>
